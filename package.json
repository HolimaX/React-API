{
  "name": "@HolimaX/beerbank-api",
  "version": "1.3.26",
  "description": "Public OpenAPI contract and fetch client for the Beer Bank API",
  "author": {
    "name": "Linards Liepins",
    "email": "hx@inbox.lv",
    "url": "https://linardsliepins.wordpress.com"
  },
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./openapi": "./src/openapi.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "postman/schemas/swagger.yaml", "README.md", "LICENSE"],
  "keywords": ["api", "openapi", "okta", "oidc", "swagger"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HolimaX/React-API.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:contract": "node --test test/openapi.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
